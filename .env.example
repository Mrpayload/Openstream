VITE_TMDB_API_KEY=
VITE_TMDB_ACCESS_TOKEN=

# MediaFusion instance URL (optional).
# Default: https://mediafusion.elfhosted.com (public, no debrid)
# For more streams, configure a debrid service at https://mediafusion.elfhosted.com/configure
# then paste the manifest base URL below (everything before /manifest.json).
# Example: https://mediafusion.elfhosted.com/your-config-token
VITE_MEDIAFUSION_URL=

# Torrentio instance URL (optional).
# Default: https://torrentio.strem.fun (public mirror of torrentio.strem.io)
# You can swap to a self-hosted instance or a regional mirror.
# Example: https://torrentio.strem.io
# Stripe instance payment URL (optional).
# Default: https://buy.stripe.com/9B6dR89g7anB5L9gOh1kA00
# Example: https://buy.stripe.com/your-custom-link
VITE_STRIPE_PAYMENT_LINK=
